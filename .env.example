# ===========================================
# RF360 - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha os valores

# ===========================================
# Supabase (Obrigatório)
# ===========================================
# Encontre em: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Conexão direta com o banco (para Prisma)
# Encontre em: https://app.supabase.com/project/_/settings/database
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ===========================================
# WhatsApp Business API (Para integração)
# ===========================================
# Encontre em: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=seu-token-de-verificacao

# ===========================================
# n8n (Para automações)
# ===========================================
N8N_WEBHOOK_URL=https://seu-n8n.app.n8n.cloud/webhook/

# ===========================================
# Aplicação
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# Opcional - Analytics & Monitoring
# ===========================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# SENTRY_DSN=
